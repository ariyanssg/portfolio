# Contact form (Resend). Without RESEND_API_KEY the form asks visitors to email directly.
RESEND_API_KEY=
# Optional: a sender on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
# Optional: where messages go. Defaults to the email in src/content/site.ts.
CONTACT_TO_EMAIL=

# Optional: the public URL once a custom domain is set (used for metadata and the sitemap).
NEXT_PUBLIC_SITE_URL=
